NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql://ntumba:ntumba@localhost:5432/ntumba
LOG_LEVEL=info
SERVE_WEB=false
JOBS_ENABLED=false

# Private operator listener. Disabled by default and never served from the public application.
OPS_ENABLED=false
OPS_HOST=127.0.0.1
OPS_PORT=9091
NTUMBA_BUILD_COMMIT=development
# Required at 32+ non-whitespace characters only when OPS_ENABLED=true. Prefer a mounted secret
# through OPS_METRICS_TOKEN_FILE in containers; never commit the token.
# OPS_METRICS_TOKEN=
# OPS_METRICS_TOKEN_FILE=

# Development quotes only. Never use a static rate in production.
RATE_PROVIDER_MODE=fake
STATIC_BTC_ZMW_RATE=1800000.00
QUOTE_TTL_SECONDS=60
FLAT_FEE_ZMW=5.00
VARIABLE_FEE_BPS=0

# Short development retention. Production values require provider, legal and regulatory review.
QUOTE_RETENTION_SECONDS=3600
INTENT_RETENTION_SECONDS=86400

# Conversion is fail-closed. Set BRIDGE_ENGINE_MODE=fake only for local simulation.
BRIDGE_ENGINE_MODE=disabled
BITCOIN_LIQUIDITY_RAIL_MODE=fake
MOBILE_MONEY_LIQUIDITY_RAIL_MODE=fake
FAKE_BITCOIN_TREASURY_BALANCE_SATS=5000000
FAKE_BITCOIN_TREASURY_INBOUND_CAPACITY_SATS=10000000
FAKE_BITCOIN_TREASURY_OUTBOUND_CAPACITY_SATS=5000000
FAKE_LIPILA_BALANCE_ZMW_MINOR=5000000
SETTLEMENT_DESTINATION_TTL_SECONDS=300
# Required only to exercise signed fake-treasury callbacks. Use 32+ random characters.
# FAKE_PROVIDER_CALLBACK_SECRET=
